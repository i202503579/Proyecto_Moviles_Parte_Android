<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_small"
    app:cardBackgroundColor="@color/blanco"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="@dimen/tamaño_zero"
    app:strokeColor="@color/gris_borde"
    app:strokeWidth="@dimen/stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/textViewNombreAlumno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/azul_oscuro"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewTelefonoApoderado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_elevation"
            android:textColor="@color/gris_texto"
            android:textSize="@dimen/text_caption" />

        <RadioGroup
            android:id="@+id/radioGroupAsistencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioPresente"
                android:layout_width="@dimen/tamaño_zero"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/estado_presente"
                android:textColor="@color/semaforo_verde"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/radioFalta"
                android:layout_width="@dimen/tamaño_zero"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/estado_falta"
                android:textColor="@color/semaforo_rojo"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/radioJustificado"
                android:layout_width="@dimen/tamaño_zero"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="@string/estado_justificado"
                android:textColor="@color/semaforo_amarillo"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />
        </RadioGroup>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>