<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/padding_login">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_login"
            android:background="@drawable/bg_panel_hero"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/padding_login">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_principal"
                android:textColor="@color/blanco"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chip_padding_vertical"
                android:text="@string/login_subtitulo_app"
                android:textColor="@color/blanco_suave"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/blanco"
            app:cardCornerRadius="@dimen/item_padding"
            app:cardElevation="@dimen/elevation_card"
            app:strokeColor="@color/gris_borde"
            app:strokeWidth="@dimen/stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_login">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/login_card_titulo"
                    android:textColor="@color/azul_oscuro"
                    android:textSize="@dimen/text_section"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutUsuario"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/gap_medium"
                    android:hint="@string/login_hint_usuario">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_padding"
                    android:hint="@string/login_hint_password"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/textViewErrorLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/gap_medium"
                    android:textColor="@color/error"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone"
                    tools:text="@string/login_error_credenciales" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonLogin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:backgroundTint="@color/verde_principal"
                    android:text="@string/login_boton_ingresar"
                    android:textAllCaps="false"
                    android:textSize="@dimen/card_radius" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/chip_padding_horizontal"
                    android:indeterminate="true"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Accesos rápidos para demostración / pruebas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_login"
            android:layout_marginBottom="@dimen/dialog_padding"
            android:text="@string/login_acceso_rapido_titulo"
            android:textColor="@color/azul_oscuro"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipOperador"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="@dimen/tamaño_zero"
                android:layout_height="@dimen/tamaño_cuarenta"
                android:layout_marginEnd="@dimen/elevation_card"
                android:layout_weight="1"
                android:text="@string/login_chip_operador"
                android:textSize="@dimen/text_button_mini" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipProfesor"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="@dimen/tamaño_zero"
                android:layout_height="@dimen/tamaño_cuarenta"
                android:layout_marginHorizontal="@dimen/elevation_card"
                android:layout_weight="1"
                android:text="@string/login_chip_profesor"
                android:textSize="@dimen/text_button_mini" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAdmin"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="@dimen/tamaño_zero"
                android:layout_height="@dimen/tamaño_cuarenta"
                android:layout_marginStart="@dimen/elevation_card"
                android:layout_weight="1"
                android:text="@string/login_chip_admin"
                android:textSize="@dimen/text_button_mini" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
