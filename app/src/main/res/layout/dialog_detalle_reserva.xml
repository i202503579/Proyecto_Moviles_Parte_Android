<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <TextView
        android:id="@+id/textViewCanchaDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/azul_oscuro"
        android:textSize="@dimen/text_dialog_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewHorarioDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_small"
        android:textColor="@color/gris_texto"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/textViewClienteDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_small"
        android:textColor="@color/gris_texto"
        android:textSize="@dimen/text_body" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonPrestamoBalonDialog"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/gap_small"
        android:text="@string/boton_prestamo_balon"
        android:textAllCaps="false"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_small"
        app:cardBackgroundColor="@color/azul_superficie"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:strokeColor="@color/gris_borde"
        app:strokeWidth="@dimen/stroke_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/gap_medium">

            <View
                android:id="@+id/viewSemaforoDialog"
                android:layout_width="@dimen/dialog_semaforo_size"
                android:layout_height="@dimen/dialog_semaforo_size"
                android:background="@drawable/bg_semaforo_neutro" />

            <TextView
                android:id="@+id/textViewEstadoDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_medium"
                android:textColor="@color/azul_oscuro"
                android:textSize="@dimen/text_item_title"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>