<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <TextView
        android:id="@+id/textViewCanchaDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/azul_oscuro"
        android:textSize="@dimen/text_dialog_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewHorarioDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_small"
        android:textColor="@color/gris_texto"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/textViewClienteDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_small"
        android:textColor="@color/gris_texto"
        android:textSize="@dimen/text_body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonRegistrarPagoDialog"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/gap_large"
        android:text="@string/boton_registrar_pago"
        android:textAllCaps="false" />

    <!-- RN08: solo se habilita si la reserva es institucional -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonPrestamoBalonDialog"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/gap_small"
        android:text="@string/boton_prestamo_balon"
        android:textAllCaps="false"
        android:visibility="gone" />

</LinearLayout>